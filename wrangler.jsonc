{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easy-host",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // To attach ship-it.com later (once its nameservers point to Cloudflare and the zone is Active):
  //   "routes": [{ "pattern": "ship-it.com", "custom_domain": true }]

  // Stores each published site as JSON { html, name, theme_color }.
  // Replace "id" with the value printed by:  npx wrangler kv namespace create SITES
  "kv_namespaces": [
    { "binding": "SITES", "id": "9bca04575f3449adb3c47a2454681c3a" },
    // Required by @cloudflare/workers-oauth-provider (stores OAuth grants/clients/tokens).
    { "binding": "OAUTH_KV", "id": "502fb104b6b349b79e1e3d5de07e1b0c" }
  ],

  // MCP server (McpAgent) + one per-app backend DO (AppBackend) for data + scheduled push.
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "EasyHostMCP" },
      { "name": "APP_OBJECT", "class_name": "AppBackend" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EasyHostMCP"] },
    { "tag": "v2", "new_sqlite_classes": ["AppBackend"] }
  ],

  // Public origin used by the MCP publish_app tool to build absolute app URLs.
  // Switch to "https://ship-it.com" once the custom domain is attached.
  "vars": {
    "PUBLIC_BASE_URL": "https://easy-host.ricky-tsou.workers.dev"
  }
}
